$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1040, Height: 660);

  #Title {
    Label #TitleLabel {
      Style: (
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderBold: true,
        RenderUppercase: true,
        FontSize: 16,
        TextColor: #d7e4ea,
        LetterSpacing: 1
      );
      Text: "HyFactions";
    }
  }

  #Content {
    LayoutMode: Left;

    Group #Categories {
      Anchor: (Width: 200);
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Right: 12, Top: 4);
    }

    Group {
      Anchor: (Width: 1, Right: 14);
      Background: #5e512c(0.55);
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #CategoryName {
        Style: (
          RenderBold: true,
          RenderUppercase: true,
          FontSize: 22,
          TextColor: #e7c56a
        );
        Anchor: (Bottom: 6);
      }

      Label #Blurb {
        Style: (
          FontSize: 14,
          Wrap: true,
          TextColor: #d5deea
        );
        Anchor: (Bottom: 10, Height: 64);
      }

      Group #Commands {
        LayoutMode: TopScrolling;
        FlexWeight: 1;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }

      Label #Hint {
        Style: (
          FontSize: 13,
          Wrap: true,
          VerticalAlignment: Center,
          TextColor: #9eb0c3
        );
        Anchor: (Top: 8, Height: 36);
        Text: "Click a command to place it in chat. Fill in anything in angle brackets, then send it.";
      }
    }
  }
}
