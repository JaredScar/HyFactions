$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1080, Height: 700);

  #Title {
    Label #TitleLabel {
      Style: (
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderBold: true,
        RenderUppercase: true,
        FontSize: 16,
        TextColor: #d7e4ea,
        LetterSpacing: 1
      );
      Text: "Manage";
    }
  }

  #Content {
    LayoutMode: Left;

    Group {
      Anchor: (Width: 236);
      LayoutMode: Top;
      Background: #0c1218(0.9);
      Padding: (Left: 8, Right: 8, Top: 10, Bottom: 8);

      Label {
        Style: (
          RenderBold: true,
          RenderUppercase: true,
          FontSize: 12,
          TextColor: #8ea0b3,
          LetterSpacing: 1
        );
        Anchor: (Bottom: 8, Left: 4);
        Text: "Factions";
      }

      Group #Factions {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
      }
    }

    Group {
      Anchor: (Width: 1, Right: 14, Left: 14);
      Background: #5e512c(0.55);
    }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #Name {
        Style: (
          RenderBold: true,
          RenderUppercase: true,
          FontSize: 22
        );
        Anchor: (Bottom: 10);
      }

      Label #Stats {
        Visible: false;
        Style: (FontSize: 14, Wrap: true, TextColor: #9eb0c3);
        Anchor: (Bottom: 8);
      }

      Group #StatRow {
        LayoutMode: Left;
        Anchor: (Height: 62, Bottom: 10);

        Group {
          FlexWeight: 1;
          Anchor: (Height: 62, Right: 8);
          Background: #15202c;
          LayoutMode: Top;
          Padding: (Left: 12, Top: 8);

          Label #MemberStat {
            Style: (RenderBold: true, FontSize: 20, TextColor: #f3f7fb);
            Anchor: (Height: 26);
            Text: "0";
          }

          Label {
            Style: (FontSize: 12, RenderUppercase: true, TextColor: #8ea0b3, LetterSpacing: 1);
            Text: "Members";
          }
        }

        Group {
          FlexWeight: 1;
          Anchor: (Height: 62, Right: 8);
          Background: #15202c;
          LayoutMode: Top;
          Padding: (Left: 12, Top: 8);

          Label #PowerStat {
            Style: (RenderBold: true, FontSize: 20, TextColor: #e7c56a);
            Anchor: (Height: 26);
            Text: "0";
          }

          Label {
            Style: (FontSize: 12, RenderUppercase: true, TextColor: #8ea0b3, LetterSpacing: 1);
            Text: "Power";
          }
        }

        Group {
          FlexWeight: 1;
          Anchor: (Height: 62, Right: 8);
          Background: #15202c;
          LayoutMode: Top;
          Padding: (Left: 12, Top: 8);

          Label #LandStat {
            Style: (RenderBold: true, FontSize: 20, TextColor: #f3f7fb);
            Anchor: (Height: 26);
            Text: "0";
          }

          Label {
            Style: (FontSize: 12, RenderUppercase: true, TextColor: #8ea0b3, LetterSpacing: 1);
            Text: "Land";
          }
        }

        Group {
          FlexWeight: 1;
          Anchor: (Height: 62, Right: 8);
          Background: #15202c;
          LayoutMode: Top;
          Padding: (Left: 12, Top: 8);

          Label #BankStat {
            Style: (RenderBold: true, FontSize: 20, TextColor: #9ddeb4);
            Anchor: (Height: 26);
            Text: "0";
          }

          Label {
            Style: (FontSize: 12, RenderUppercase: true, TextColor: #8ea0b3, LetterSpacing: 1);
            Text: "Bank";
          }
        }

        Group {
          FlexWeight: 1;
          Anchor: (Height: 62);
          Background: #15202c;
          LayoutMode: Top;
          Padding: (Left: 12, Top: 8);

          Label #BoostStat {
            Style: (RenderBold: true, FontSize: 20, TextColor: #e7c56a);
            Anchor: (Height: 26);
            Text: "0";
          }

          Label {
            Style: (FontSize: 12, RenderUppercase: true, TextColor: #8ea0b3, LetterSpacing: 1);
            Text: "Boost";
          }
        }
      }

      Label #Flags {
        Style: (FontSize: 14, Wrap: true, TextColor: #c5d2df);
        Anchor: (Bottom: 6, Height: 40);
      }

      Label #About {
        Style: (FontSize: 14, Wrap: true, TextColor: #c5d0dc);
        Anchor: (Bottom: 4);
      }

      Label #Notice {
        Visible: false;
        Style: (FontSize: 14, Wrap: true, TextColor: #e7c56a);
        Anchor: (Bottom: 6);
      }

      Group #Body {
        LayoutMode: Left;
        FlexWeight: 1;
        Anchor: (Top: 6);

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Background: #121a24;
          Padding: (Left: 12, Right: 12, Top: 12, Bottom: 10);

          Label #MembersTitle {
            Style: (
              RenderBold: true,
              RenderUppercase: true,
              FontSize: 12,
              TextColor: #8ea0b3,
              LetterSpacing: 1
            );
            Anchor: (Bottom: 8);
            Text: "Members";
          }

          Group #Members {
            LayoutMode: TopScrolling;
            FlexWeight: 1;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
          }
        }

        Group {
          Anchor: (Width: 10);
        }

        Group #FactionActions {
          Anchor: (Width: 400);
          LayoutMode: Top;
          Background: #121a24;
          Padding: (Left: 12, Right: 12, Top: 12, Bottom: 12);

          Label {
            Style: (
              RenderBold: true,
              RenderUppercase: true,
              FontSize: 12,
              TextColor: #8ea0b3,
              LetterSpacing: 1
            );
            Anchor: (Bottom: 4);
            Text: "Rules";
          }

          Label {
            Style: (FontSize: 12, Wrap: true, TextColor: #8ea0b3);
            Anchor: (Bottom: 8, Height: 46);
            Text: "Lock stops member edits. Permanent blocks disband. Open lets anyone join. Peaceful blocks fights.";
          }

          Group {
            LayoutMode: Left;
            Anchor: (Bottom: 6, Height: 36);

            $C.@TextButton #Lock { @Text = "Lock"; @Anchor = (Width: 176, Right: 8); }
            $C.@TextButton #Permanent { @Text = "Permanent"; @Anchor = (Width: 176); }
          }

          Group {
            LayoutMode: Left;
            Anchor: (Bottom: 12, Height: 36);

            $C.@TextButton #Open { @Text = "Open"; @Anchor = (Width: 176, Right: 8); }
            $C.@TextButton #Peaceful { @Text = "Peaceful"; @Anchor = (Width: 176); }
          }

          Label {
            Style: (
              RenderBold: true,
              RenderUppercase: true,
              FontSize: 12,
              TextColor: #8ea0b3,
              LetterSpacing: 1
            );
            Anchor: (Bottom: 4);
            Text: "Power boost";
          }

          Label {
            Style: (FontSize: 12, Wrap: true, TextColor: #8ea0b3);
            Anchor: (Bottom: 8);
            Text: "Extra power that stays until you clear it.";
          }

          Group {
            LayoutMode: Left;
            Anchor: (Bottom: 10, Height: 36);

            $C.@TextButton #BoostUp { @Text = "+10"; @Anchor = (Width: 114, Right: 8); }
            $C.@TextButton #BoostDown { @Text = "-10"; @Anchor = (Width: 114, Right: 8); }
            $C.@TextButton #BoostClear { @Text = "Clear"; @Anchor = (Width: 116); }
          }

          $C.@CancelTextButton #Disband { @Text = "Disband"; @Anchor = (Width: 360, Bottom: 6, Height: 36); }

          Label #DisbandHint {
            Style: (FontSize: 12, Wrap: true, TextColor: #8ea0b3);
            Text: "Deletes this faction and releases its land.";
          }
        }
      }

      Group #Chunk {
        LayoutMode: Top;
        Background: #121a24;
        Padding: (Left: 12, Right: 12, Top: 10, Bottom: 12);
        Anchor: (Top: 10);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 36, Bottom: 4);

          Label {
            Style: (
              RenderBold: true,
              RenderUppercase: true,
              FontSize: 12,
              VerticalAlignment: Center,
              TextColor: #8ea0b3,
              LetterSpacing: 1
            );
            Anchor: (Height: 36);
            Text: "This chunk";
          }

          Group { FlexWeight: 1; }

          $C.@TextButton #Bypass { @Text = "Bypass"; @Anchor = (Width: 160, Height: 36); }
        }

        Label #Here {
          Style: (FontSize: 14, Wrap: true, TextColor: #d5deea);
          Anchor: (Bottom: 8);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Bottom: 8, Height: 36);

          $C.@TextButton #Unclaim { @Text = "Unclaim"; @Anchor = (Width: 156, Right: 8); }
          $C.@TextButton #Claim { @Text = "Claim"; @Anchor = (Width: 156, Right: 8); }
          $C.@TextButton #Safezone { @Text = "Safezone"; @Anchor = (Width: 156, Right: 8); }
          $C.@TextButton #Warzone { @Text = "Warzone"; @Anchor = (Width: 156); }
        }

        Label {
          Style: (FontSize: 12, Wrap: true, TextColor: #8ea0b3);
          Text: "Unclaim clears this chunk. Claim gives it to the selected faction.";
        }
      }
    }
  }
}
